# Supabase connection for the PUBLIC website (runs in the browser).
#
# These use the PUBLIC "anon" / publishable key ONLY — the key that is safe to
# ship in a website. It can do only what our Row Level Security allows (read the
# `crews` table). The app NEVER uses the secret / service_role key.
#
# Setup:
#   1) Copy this file to .env.local :   cp .env.example .env.local
#   2) Fill in both values from Supabase: Project Settings -> API
#   (.env.local is gitignored, so your values are never committed.)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key


# Shows or hides the public crew-submission flow — BOTH doors at once: the
# "Submit a crew" card on the landing page and the "Add a missing crew" link on
# the map panel. One switch on purpose, so the two can't drift apart.
#
# Must be the exact string "true" to turn it on. Anything else — including
# unset, which is the default — leaves it off. Fail-closed is deliberate: this
# gates the only path that lets strangers write to the database.
#
# The /submit page itself stays reachable by URL either way. This controls
# whether anything LINKS to it, so the feature can be reviewed on a live deploy
# before it's discoverable.
#
# Set it in Vercel (Project → Settings → Environment Variables) for the live
# site. Setting it here only affects local `npm run dev`.
NEXT_PUBLIC_SUBMISSIONS_ENABLED=false
